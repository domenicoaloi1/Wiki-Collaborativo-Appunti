# project/.env.example
# Copia questo file in .env (run_project.sh lo fa da solo se manca) e personalizza i valori.
# .env è in .gitignore: le credenziali reali non vanno mai committate.

# --- MySQL (letti dal container db e dal backend) ---
MYSQL_DATABASE=wiki_db
MYSQL_USER=wiki_user
MYSQL_PASSWORD=wiki_password
MYSQL_ROOT_PASSWORD=root_password

# --- Backend ---
# Host del DB visto dal container backend (nome del servizio in docker-compose)
DB_HOST=db
# Origine del frontend autorizzata dal CORS
CORS_ALLOWED_ORIGIN=http://localhost:8080
